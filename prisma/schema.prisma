  installations  app_installation[]
  extensions     app_extension[]

  @@index([status, category])
}

model app_installation {
  id                Int             @id @default(autoincrement())
  app_id            Int
  store_id          Int
  status            String          @default("installed") @db.VarChar(30)
  access_token_hash String?         @db.VarChar(128)
  scopes            Json
  settings          Json?
  installed_version String?         @db.VarChar(30)
  installed_at      DateTime?       @default(now()) @db.Timestamp(6)
  uninstalled_at    DateTime?       @db.Timestamp(6)
  app               platform_app    @relation(fields: [app_id], references: [id], onDelete: Cascade)
  webhooks          app_webhook[]
  extensions        app_extension[]

  @@unique([app_id, store_id])
  @@index([store_id, status])
}

model app_webhook {
  id              Int                    @id @default(autoincrement())
  installation_id Int
  store_id        Int
  topic           String                 @db.VarChar(80)
  target_url      String                 @db.VarChar(500)
  secret          String                 @db.VarChar(128)
  created_at      DateTime?              @default(now()) @db.Timestamp(6)
  installation    app_installation       @relation(fields: [installation_id], references: [id], onDelete: Cascade)
  deliveries      app_webhook_delivery[]

  @@index([store_id, topic])
  @@index([installation_id])
}

model app_webhook_delivery {
  id         Int         @id @default(autoincrement())
  webhook_id Int
  store_id   Int
  event      String      @db.VarChar(80)
  status     String      @default("pending") @db.VarChar(30)
  attempts   Int         @default(0)
  last_error String?
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  webhook    app_webhook @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id, status])
}

model app_extension {
  id              Int               @id @default(autoincrement())
  app_id          Int
  installation_id Int?
  store_id        Int
  point           String            @db.VarChar(80)
  config          Json?
  enabled         Boolean           @default(true)
  app             platform_app      @relation(fields: [app_id], references: [id], onDelete: Cascade)
  installation    app_installation? @relation(fields: [installation_id], references: [id], onDelete: Cascade)

  @@index([store_id, point])
}

model page_blueprint {
  id                Int       @id @default(autoincrement())
  store_id          Int
  theme_id          Int?
  page_type         String    @db.VarChar(50)
  title             String    @db.VarChar(255)
  slug              String?   @db.VarChar(255)
  description       String?   @db.Text
  blueprint_json    Json
  is_published      Boolean   @default(false)
  version           Int       @default(1)
  generation_job_id String?   @unique @db.VarChar(120)
  created_by        Int?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  store             store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  versions          page_blueprint_version[]

  @@index([store_id])
}

model page_blueprint_version {
  id             Int            @id @default(autoincrement())
  page_id        Int
  version_number Int
  blueprint_json Json
  created_by     Int?
  created_at     DateTime?      @default(now()) @db.Timestamp(6)
  page           page_blueprint @relation(fields: [page_id], references: [id], onDelete: Cascade)

  @@index([page_id])
}

model ai_custom_section {
  id                Int       @id @default(autoincrement())
  store_id          Int
  theme_id          Int?
  page_id           Int?
  name              String    @db.VarChar(255)
  prompt            String    @db.Text
  blueprint         Json?
  status            String    @default("generating") @db.VarChar(50)
  progress          Int       @default(0)
  generation_job_id String?   @db.VarChar(100)
  model_name        String?   @db.VarChar(50)
  error_code        String?   @db.VarChar(50)
  error_message     String?   @db.Text
  created_by        Int?
  updated_by        Int?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  store             store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  versions          ai_custom_section_version[]

  @@index([store_id])
}

model ai_custom_section_version {
  id         Int       @id @default(autoincrement())
  section_id Int
  blueprint  Json
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  section    ai_custom_section @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@index([section_id])
}
